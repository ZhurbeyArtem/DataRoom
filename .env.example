# --- Postgres ---
# Локально: PostgreSQL на 5432, базу dataroom створить prisma migrate.
# На продакшні — connection string із Supabase.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/dataroom?schema=public"

# --- Supabase Storage ---
# Ключі нового формату: sb_secret_… замість застарілого service_role JWT.
# Секретний ключ дає повний доступ до сховища — тільки на бекенді.
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SECRET_KEY=""
SUPABASE_BUCKET="dataroom-files"

# --- Auth ---
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# --- Інше ---
PORT=3000
WEB_ORIGIN="http://localhost:5173"
