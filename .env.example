# --- Postgres ---
# Локально: PostgreSQL 18 на порту 5432. Базу dataroom створить prisma migrate.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/dataroom?schema=public"

# --- Supabase Storage (заповнюється перед Задачею 8) ---
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="dataroom-files"

# --- Auth ---
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# --- Інше ---
PORT=3000
WEB_ORIGIN="http://localhost:5173"
