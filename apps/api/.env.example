# Postgres. In production use the Supabase Session pooler string (port 5432).
# The Transaction pooler (6543) will not work: it does not pass through the
# startup parameter `options: '-c timezone=UTC'` that PrismaService connects with.
DATABASE_URL=postgresql://user:password@localhost:5432/dataroom

# Supabase is used for file storage only.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=dataroom-files

# Every environment gets its own secrets. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Exact frontend origin, no trailing slash: the value goes into CORS as is.
WEB_ORIGIN=http://localhost:5173

# production enables secure/sameSite=none for the refresh cookie.
NODE_ENV=development

# 3000 locally; on Render the platform supplies the port — leave it unset there.
PORT=3000
