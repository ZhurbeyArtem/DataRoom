# Postgres. На проді — рядок Session pooler із Supabase (порт 5432).
# Transaction pooler (6543) не підходить: він не пропускає параметр запуску
# `options: '-c timezone=UTC'`, з яким підключається PrismaService.
DATABASE_URL=postgresql://user:password@localhost:5432/dataroom

# Supabase — лише сховище файлів.
SUPABASE_URL=https://<проєкт>.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=dataroom-files

# Кожне середовище має власні секрети. Згенерувати:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Точний домен фронта, без слеша в кінці: значення йде в CORS як є.
WEB_ORIGIN=http://localhost:5173

# production вмикає secure/sameSite=none для refresh-cookie.
NODE_ENV=development

# Локально 3000; на Render порт підставляє платформа — змінну не задавати.
PORT=3000
